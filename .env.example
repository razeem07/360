# Copy this file to .env and fill in real values. .env is gitignored — never
# commit secrets (CLAUDE.md rule 8).

DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# BACKTEST | PAPER | LIVE — must never be LIVE before Phase 3 (CLAUDE.md rule 5).
TRADING_MODE=BACKTEST

# Dotted path to the active broker adapter class (marketdata/broker.py).
BROKER_ADAPTER=marketdata.broker.fyers_adapter.FyersAdapter

# Fyers API v3 credentials — from https://myapi.fyers.in/dashboard
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=
# Obtained daily via: python manage.py fyers_login
FYERS_ACCESS_TOKEN=

# Optional: PostgreSQL (leave unset to use local SQLite per PRD §5)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
